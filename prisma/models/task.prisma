model Task {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  
  authorId     String
  author       Member   @relation("AuthoredTasks", fields: [authorId], references: [id])
  participants Member[]

  start        DateTime
  duration     Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  updatedById  String
  updatedBy    Member   @relation("UpdatedTasks", fields: [updatedById], references: [id])

  period     String?
} 