model Attachment {
    id       String @id @default(uuid())
    memoryId String
    memory   Memory @relation(fields: [memoryId], references: [id])

    storageId String
    storage   Storage @relation(fields: [storageId], references: [id])

    extension String?
    type      FileType
    url       String
    key       String // Уникальный ключ/путь файла в хранилище
}

enum FileType {
    AUDIO
    VIDEO
    IMAGE
}
